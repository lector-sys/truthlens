# Copy to .env (git-ignored). Real environment variables override these.
# Providers are tried in order: LLM_PROVIDER first, then the rest of LLM_PROVIDERS (ollama | groq | openai).
# Cloud providers (groq, openai) are used ONLY if listed here: list them only if the user agrees evidence may leave.
LLM_PROVIDER=ollama
LLM_PROVIDERS=ollama
OLLAMA_URL=http://<gpu-host>.<tailnet>.ts.net:11434/v1
TRUTHLENS_TEXT_MODEL=truthlens-vl
TRUTHLENS_VISION_MODEL=truthlens-vl
WHISPER_URL=http://<gpu-host>.<tailnet>.ts.net:8080
WHISPER_LIVE_MODEL_NOTE=server runs large-v3-turbo; small available
# Trained AI-generation detectors (FastAPI on the GPU host)
DETECTORS_URL=http://<gpu-host>.<tailnet>.ts.net:8090
# Cloud fallbacks (only used if listed in LLM_PROVIDERS and set):
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
TRUTHLENS_MODEL=gpt-5.6-luna
TRUTHLENS_TRANSCRIBE_MODEL=whisper-1
# Full path to c2patool if it is not on PATH (verified C2PA manifests; see README)
C2PATOOL=
# Public demo mode (off unless set to 1); the access code lives only here
TRUTHLENS_PUBLIC=
TRUTHLENS_ACCESS_CODE=
